-- 3.a عمولات الناشرين المعلّقة → رصيد متاح فوراً
DO $$
DECLARE tx record; w_id uuid;
BEGIN
  FOR tx IN
    SELECT wt.id, wt.user_id, wt.amount
      FROM public.wallet_transactions wt
      JOIN public.orders o ON o.id = wt.order_id
     WHERE wt.type = 'pending_credit'
       AND wt.status = 'pending'
       AND o.affiliate_user_id = wt.user_id
  LOOP
    SELECT id INTO w_id FROM public.wallets WHERE user_id = tx.user_id;
    IF w_id IS NULL THEN CONTINUE; END IF;

    UPDATE public.wallets
       SET pending_balance   = GREATEST(pending_balance - tx.amount, 0),
           available_balance = available_balance + tx.amount,
           updated_at        = now()
     WHERE user_id = tx.user_id;

    UPDATE public.wallet_transactions
       SET type        = 'credit',
           status      = 'completed',
           description = 'عمولة تسويق بالعمولة — متاحة فوراً'
     WHERE id = tx.id;
  END LOOP;
END $$;

