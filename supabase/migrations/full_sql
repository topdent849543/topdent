--  12) المحادثات، الإشعارات، ودردشة الذكاء الاصطناعي
--  (20260813000000_chat_ai_notifications.sql)
-- ════════════════════════════════════════════════════════════════════════

/*
  # نظام المحادثات (زبون ↔ تاجر) + إعدادات الذكاء الاصطناعي + إصلاح علاقات PostgREST

  1. إصلاح العلاقات
     - إضافة مفاتيح أجنبية بين `products.merchant_id → profiles.id`
       و `orders.user_id → profiles.id` حتى يتمكن PostgREST من عمل
       embed مثل: `products?select=*,merchant:profiles!merchant_id(*)`
       (سبب الخطأ: Could not find a relationship between 'products' and 'profiles').

  2. جداول جديدة
     - `chats`          : محادثة بين زبون وتاجر حول منتج محدد (لكل منتج/زبون محادثة واحدة).
     - `chat_messages`  : رسائل المحادثة — لا يمكن حذفها أو تعديلها من الزبون أو التاجر إطلاقاً.

  3. الأمان
     - RLS مفعّل: يرى المحادثة أطرافها فقط (+ الأدمن).
     - لا توجد أي سياسة DELETE/UPDATE للرسائل لغير الأدمن (الحذف للأدمن فقط).
     - هوية الزبون لا تُعرض للتاجر: الواجهة تعتمد على `chats.code` فقط،
       والدالة `merchant_chat_list()` لا تُرجع أي معلومات شخصية عن الزبون.

  4. الإشعارات
     - trigger يضيف إشعاراً للطرف الآخر عند كل رسالة جديدة.

  5. إعدادات الذكاء الاصطناعي
     - `ai_settings` (صف واحد) يديره الأدمن من لوحة التحكم ← الإعدادات.
     - مفتاح الـ API لا يُقرأ إلا من الأدمن أو من service_role (Edge Function).
*/

-- ─────────────────────────────────────────────────────────────
-- 1) إصلاح علاقات PostgREST
-- ─────────────────────────────────────────────────────────────
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns
             WHERE table_schema = 'public' AND table_name = 'products' AND column_name = 'merchant_id')
     AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'products_merchant_id_profiles_fkey')
  THEN
    -- تنظيف أي قيم يتيمة قبل إضافة القيد
    UPDATE public.products p
       SET merchant_id = NULL
     WHERE p.merchant_id IS NOT NULL
       AND NOT EXISTS (SELECT 1 FROM public.profiles pr WHERE pr.id = p.merchant_id);

    ALTER TABLE public.products
      ADD CONSTRAINT products_merchant_id_profiles_fkey
      FOREIGN KEY (merchant_id) REFERENCES public.profiles(id) ON DELETE SET NULL;
  END IF;
END $$;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'orders_user_id_profiles_fkey')
     AND NOT EXISTS (
       SELECT 1 FROM public.orders o
        WHERE o.user_id IS NOT NULL
          AND NOT EXISTS (SELECT 1 FROM public.profiles pr WHERE pr.id = o.user_id)
     )
  THEN
    ALTER TABLE public.orders
      ADD CONSTRAINT orders_user_id_profiles_fkey
      FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;
  END IF;
END $$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns
             WHERE table_schema = 'public' AND table_name = 'reels' AND column_name = 'merchant_id')
     AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'reels_merchant_id_profiles_fkey')
  THEN
    UPDATE public.reels r
       SET merchant_id = NULL
     WHERE r.merchant_id IS NOT NULL
       AND NOT EXISTS (SELECT 1 FROM public.profiles pr WHERE pr.id = r.merchant_id);

    ALTER TABLE public.reels
      ADD CONSTRAINT reels_merchant_id_profiles_fkey
      FOREIGN KEY (merchant_id) REFERENCES public.profiles(id) ON DELETE SET NULL;
  END IF;
END $$;

NOTIFY pgrst, 'reload schema';

-- ─────────────────────────────────────────────────────────────
-- 2) جداول المحادثات
-- ─────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS public.chats (
  id                uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  code              text UNIQUE NOT NULL,
  product_id        uuid NOT NULL REFERENCES public.products(id) ON DELETE CASCADE,
  customer_id       uuid NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  merchant_id       uuid NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  last_message      text,
  last_message_at   timestamptz NOT NULL DEFAULT now(),
  customer_unread   integer NOT NULL DEFAULT 0,
  merchant_unread   integer NOT NULL DEFAULT 0,
  is_archived       boolean NOT NULL DEFAULT false,
  created_at        timestamptz NOT NULL DEFAULT now()
);

CREATE UNIQUE INDEX IF NOT EXISTS chats_product_customer_key
  ON public.chats (product_id, customer_id);
CREATE INDEX IF NOT EXISTS chats_merchant_idx ON public.chats (merchant_id, last_message_at DESC);
CREATE INDEX IF NOT EXISTS chats_customer_idx ON public.chats (customer_id, last_message_at DESC);

CREATE TABLE IF NOT EXISTS public.chat_messages (
  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  chat_id     uuid NOT NULL REFERENCES public.chats(id) ON DELETE CASCADE,
  sender_id   uuid REFERENCES public.profiles(id) ON DELETE SET NULL,
  sender_role text NOT NULL CHECK (sender_role IN ('customer', 'merchant', 'system')),
  body        text NOT NULL CHECK (length(btrim(body)) > 0),
  created_at  timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS chat_messages_chat_idx ON public.chat_messages (chat_id, created_at ASC);

ALTER TABLE public.chats ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.chat_messages ENABLE ROW LEVEL SECURITY;

GRANT SELECT, INSERT, UPDATE ON public.chats TO authenticated;
GRANT SELECT, INSERT ON public.chat_messages TO authenticated;
GRANT ALL ON public.chats TO service_role;
GRANT ALL ON public.chat_messages TO service_role;

-- المحادثات: الأطراف + الأدمن
DROP POLICY IF EXISTS "chats_select_participants" ON public.chats;
CREATE POLICY "chats_select_participants" ON public.chats
  FOR SELECT TO authenticated
  USING (auth.uid() = customer_id OR auth.uid() = merchant_id OR public.is_admin());

DROP POLICY IF EXISTS "chats_update_participants" ON public.chats;
