/* تعيين الصورة الرئيسية */
CREATE OR REPLACE FUNCTION public.set_primary_product_image(p_product_id uuid, p_image_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  IF NOT public.can_manage_product(p_product_id) THEN
    RAISE EXCEPTION 'غير مصرّح لك بتعديل صور هذا المنتج';
