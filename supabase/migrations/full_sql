  FOR DELETE TO authenticated
  USING (public.is_admin());

-- ─────────────────────────────────────────────────────────────
-- 3) إنشاء/جلب محادثة لمنتج (الزبون هو من يفتحها)
-- ─────────────────────────────────────────────────────────────
CREATE OR REPLACE FUNCTION public.get_or_create_product_chat(p_product_id uuid)
RETURNS public.chats
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_uid        uuid := auth.uid();
  v_merchant   uuid;
  v_name       text;
  v_slug       text;
  v_chat       public.chats;
  v_code       text;
BEGIN
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'يجب تسجيل الدخول لبدء محادثة';
  END IF;

  SELECT merchant_id, name, slug INTO v_merchant, v_name, v_slug
    FROM public.products WHERE id = p_product_id;

  IF v_merchant IS NULL THEN
    RAISE EXCEPTION 'هذا المنتج غير مرتبط بتاجر';
  END IF;

  IF v_merchant = v_uid THEN
    RAISE EXCEPTION 'لا يمكنك بدء محادثة مع نفسك';
  END IF;

  SELECT * INTO v_chat FROM public.chats
   WHERE product_id = p_product_id AND customer_id = v_uid;

  IF FOUND THEN
    RETURN v_chat;
  END IF;

  v_code := 'Chat-' ||
            substr(md5(gen_random_uuid()::text), 1, 4) || '-' ||
            substr(md5(gen_random_uuid()::text), 1, 5) || '-' ||
            substr(md5(gen_random_uuid()::text), 1, 2);

  INSERT INTO public.chats (code, product_id, customer_id, merchant_id, last_message, last_message_at)
  VALUES (v_code, p_product_id, v_uid, v_merchant, v_name, now())
  RETURNING * INTO v_chat;

  -- أول رسالة دائماً: المنتج الذي فُتحت منه المحادثة
  INSERT INTO public.chat_messages (chat_id, sender_id, sender_role, body)
  VALUES (
    v_chat.id, NULL, 'system',
    'المنتج: ' || v_name || E'\n' || 'product://' || COALESCE(v_slug, p_product_id::text)
  );

  RETURN v_chat;
END $$;

REVOKE ALL ON FUNCTION public.get_or_create_product_chat(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_or_create_product_chat(uuid) TO authenticated;

-- ─────────────────────────────────────────────────────────────
-- 4) trigger: تحديث المحادثة + إشعار الطرف الآخر
-- ─────────────────────────────────────────────────────────────
CREATE OR REPLACE FUNCTION public.handle_new_chat_message()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_chat      public.chats;
  v_target    uuid;
  v_title     text;
BEGIN
  SELECT * INTO v_chat FROM public.chats WHERE id = NEW.chat_id;
  IF NOT FOUND THEN RETURN NEW; END IF;

  IF NEW.sender_role = 'customer' THEN
    UPDATE public.chats
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at,
           merchant_unread = merchant_unread + 1
     WHERE id = NEW.chat_id;
    v_target := v_chat.merchant_id;
    v_title  := 'رسالة جديدة — ' || v_chat.code;
  ELSIF NEW.sender_role = 'merchant' THEN
    UPDATE public.chats
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at,
           customer_unread = customer_unread + 1
     WHERE id = NEW.chat_id;
    v_target := v_chat.customer_id;
    v_title  := 'رد من التاجر';
  ELSE
    UPDATE public.chats
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at
     WHERE id = NEW.chat_id;
    RETURN NEW;
  END IF;

  IF v_target IS NOT NULL THEN
    INSERT INTO public.notifications (user_id, type, title, body, data)
    VALUES (
      v_target, 'chat', v_title, left(NEW.body, 160),
      jsonb_build_object('chat_id', v_chat.id, 'code', v_chat.code, 'product_id', v_chat.product_id)
    );
  END IF;

  RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_new_chat_message ON public.chat_messages;
CREATE TRIGGER trg_new_chat_message
  AFTER INSERT ON public.chat_messages
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_chat_message();

