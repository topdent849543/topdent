  ON public.product_images (product_id, is_primary DESC, sort_order ASC);

-- ضبط صورة رئيسية واحدة لكل منتج لا يملك واحدة
UPDATE public.product_images pi
   SET is_primary = true
 WHERE NOT EXISTS (
   SELECT 1 FROM public.product_images x
    WHERE x.product_id = pi.product_id AND x.is_primary
 )
 AND pi.id = (
   SELECT y.id FROM public.product_images y
    WHERE y.product_id = pi.product_id
    ORDER BY y.sort_order ASC, y.created_at ASC
    LIMIT 1
 );

