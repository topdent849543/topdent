CREATE OR REPLACE FUNCTION public.trg_order_confirmed_sales()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  IF NEW.status IN ('confirmed','processing','shipped','out_for_delivery','delivered','completed')
     AND COALESCE(OLD.status, '') <> NEW.status THEN
    PERFORM public.confirm_order_merchant_sales(NEW.id);
  END IF;
