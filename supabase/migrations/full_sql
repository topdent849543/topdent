RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  IF public.is_admin() THEN
    UPDATE public.support_tickets SET admin_unread = 0 WHERE id = p_ticket_id;
  ELSE
    UPDATE public.support_tickets
       SET user_unread = 0
     WHERE id = p_ticket_id AND user_id = auth.uid();
  END IF;
END $$;

