    sender_id = auth.uid() AND EXISTS (
      SELECT 1 FROM public.chats c
       WHERE c.id = chat_messages.chat_id
         AND (
           (c.customer_id = auth.uid() AND chat_messages.sender_role = 'customer') OR
           (c.merchant_id = auth.uid() AND chat_messages.sender_role = 'merchant')
         )
    )
  );

-- لا سياسة UPDATE ولا DELETE للرسائل: محفوظة للأبد لكلا الطرفين.
DROP POLICY IF EXISTS "chat_messages_delete_admin_only" ON public.chat_messages;
