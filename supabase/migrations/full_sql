/* تحديث الإعدادات — أدمن فقط. إبقاء المفتاح كما هو عند تمرير NULL. */
CREATE OR REPLACE FUNCTION public.update_ai_settings(p_settings jsonb)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE v_row public.ai_settings;
BEGIN
  IF NOT public.is_admin() THEN
    RAISE EXCEPTION 'هذه العملية مخصّصة للأدمن فقط';
  END IF;

  UPDATE public.ai_settings SET
    is_enabled    = COALESCE((p_settings->>'is_enabled')::boolean, is_enabled),
    api_key       = CASE WHEN p_settings ? 'api_key' AND btrim(COALESCE(p_settings->>'api_key','')) <> ''
                         THEN btrim(p_settings->>'api_key') ELSE api_key END,
    model         = COALESCE(NULLIF(btrim(COALESCE(p_settings->>'model','')), ''), model),
    system_prompt = COALESCE(p_settings->>'system_prompt', system_prompt),
    welcome_text  = COALESCE(p_settings->>'welcome_text', welcome_text),
    updated_at    = now()
  WHERE id = true
  RETURNING * INTO v_row;

  RETURN jsonb_build_object(
    'is_enabled', v_row.is_enabled,
    'model', v_row.model,
    'system_prompt', v_row.system_prompt,
    'welcome_text', v_row.welcome_text,
    'has_key', (v_row.api_key IS NOT NULL AND length(btrim(v_row.api_key)) > 0)
  );
END $$;

GRANT EXECUTE ON FUNCTION public.update_ai_settings(jsonb) TO authenticated;

/* إعدادات كاملة للأدمن (مع إخفاء المفتاح جزئياً) */
CREATE OR REPLACE FUNCTION public.get_ai_admin_settings()
RETURNS jsonb
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT CASE WHEN public.is_admin() THEN jsonb_build_object(
    'is_enabled', s.is_enabled,
    'model', s.model,
    'system_prompt', s.system_prompt,
    'welcome_text', s.welcome_text,
    'has_key', (s.api_key IS NOT NULL AND length(btrim(s.api_key)) > 0),
    'key_hint', CASE WHEN s.api_key IS NULL OR length(s.api_key) < 8 THEN NULL
                     ELSE '••••' || right(s.api_key, 4) END
  ) ELSE NULL END
  FROM public.ai_settings s WHERE s.id = true;
$$;

GRANT EXECUTE ON FUNCTION public.get_ai_admin_settings() TO authenticated;

