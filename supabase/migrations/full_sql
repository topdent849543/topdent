--  13) ترقية Pro، الصور، ودعم الذكاء الاصطناعي
--  (20260813120000_pro_upgrade_images_support_ai.sql)
-- ════════════════════════════════════════════════════════════════════════

/*
  # ترقية احترافية شاملة
  =====================================================================
  1. صور متعددة للمنتج + اختيار الصورة الرئيسية
     - `product_images.is_primary` + فهارس + دالة `set_primary_product_image`.
     - دالة `sync_product_images` لحفظ كل الصور دفعة واحدة (تاجر/أدمن).

  2. نظام تذاكر الدعم الكامل
     - أعمدة إضافية على `support_tickets` (رقم التذكرة، آخر رسالة، غير المقروء).
     - جدول `support_ticket_messages` (محادثة بين الزبون والأدمن).
     - سياسات RLS: الزبون يرى تذاكره فقط، والأدمن يرى الكل ويرد عليها.
     - Triggers: إشعار فوري للأدمن عند تذكرة جديدة، وإشعار للزبون عند الرد.

  3. إشعارات فورية
     - إشعار لكل الأدمن عند أي طلب/طلب شحن جديد.
     - إشعار للتاجر عند وصول طلب يخص أحد منتجاته.

  4. إعدادات الذكاء الاصطناعي (Groq) — يديرها الأدمن من صفحة الإعدادات.

  لا يحذف هذا الملف أي شيء موجود — كل التغييرات إضافية وآمنة للتشغيل المتكرر.
*/

-- ═════════════════════════════════════════════════════════════
-- 0) أدوات مساعدة
-- ═════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.is_admin(p_user_id uuid DEFAULT auth.uid())
RETURNS boolean
LANGUAGE sql
STABLE
SECURITY DEFINER
SET search_path = public
AS $$
  SELECT EXISTS (SELECT 1 FROM public.profiles WHERE id = p_user_id AND role = 'admin');
$$;

REVOKE ALL ON FUNCTION public.is_admin(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.is_admin(uuid) TO authenticated, service_role;

-- ═════════════════════════════════════════════════════════════
-- 1) صور متعددة للمنتج + الصورة الرئيسية
-- ═════════════════════════════════════════════════════════════
ALTER TABLE public.product_images
  ADD COLUMN IF NOT EXISTS is_primary boolean NOT NULL DEFAULT false;

CREATE INDEX IF NOT EXISTS idx_product_images_primary
  ON public.product_images (product_id, is_primary DESC, sort_order ASC);

-- ضبط صورة رئيسية واحدة لكل منتج لا يملك واحدة
UPDATE public.product_images pi
   SET is_primary = true
 WHERE NOT EXISTS (
   SELECT 1 FROM public.product_images x
    WHERE x.product_id = pi.product_id AND x.is_primary
 )
 AND pi.id = (
   SELECT y.id FROM public.product_images y
    WHERE y.product_id = pi.product_id
    ORDER BY y.sort_order ASC, y.created_at ASC
    LIMIT 1
 );

