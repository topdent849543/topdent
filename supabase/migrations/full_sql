DO $$
DECLARE c_name text;
BEGIN
  SELECT conname INTO c_name
    FROM pg_constraint
   WHERE conrelid = 'public.orders'::regclass
     AND contype = 'c'
     AND pg_get_constraintdef(oid) ILIKE '%status%'
     AND pg_get_constraintdef(oid) NOT ILIKE '%payment_status%'
     AND pg_get_constraintdef(oid) NOT ILIKE '%invoice_token%'
   LIMIT 1;
  IF c_name IS NOT NULL THEN
    EXECUTE format('ALTER TABLE public.orders DROP CONSTRAINT %I', c_name);
  END IF;
END $$;

ALTER TABLE public.orders
  ADD CONSTRAINT orders_status_check
  CHECK (status IN ('pending','confirmed','processing','shipped','out_for_delivery',
                    'delivered','completed','cancelled','returned','refunded'));

-- ════════════════════════════════════════════════════════════════════════
--  12) المحادثات، الإشعارات، ودردشة الذكاء الاصطناعي
--  (20260813000000_chat_ai_notifications.sql)
-- ════════════════════════════════════════════════════════════════════════

/*
  # نظام المحادثات (زبون ↔ تاجر) + إعدادات الذكاء الاصطناعي + إصلاح علاقات PostgREST

  1. إصلاح العلاقات
     - إضافة مفاتيح أجنبية بين `products.merchant_id → profiles.id`
       و `orders.user_id → profiles.id` حتى يتمكن PostgREST من عمل
       embed مثل: `products?select=*,merchant:profiles!merchant_id(*)`
       (سبب الخطأ: Could not find a relationship between 'products' and 'profiles').

  2. جداول جديدة
     - `chats`          : محادثة بين زبون وتاجر حول منتج محدد (لكل منتج/زبون محادثة واحدة).
     - `chat_messages`  : رسائل المحادثة — لا يمكن حذفها أو تعديلها من الزبون أو التاجر إطلاقاً.

  3. الأمان
     - RLS مفعّل: يرى المحادثة أطرافها فقط (+ الأدمن).
     - لا توجد أي سياسة DELETE/UPDATE للرسائل لغير الأدمن (الحذف للأدمن فقط).
     - هوية الزبون لا تُعرض للتاجر: الواجهة تعتمد على `chats.code` فقط،
       والدالة `merchant_chat_list()` لا تُرجع أي معلومات شخصية عن الزبون.

  4. الإشعارات
     - trigger يضيف إشعاراً للطرف الآخر عند كل رسالة جديدة.

  5. إعدادات الذكاء الاصطناعي
     - `ai_settings` (صف واحد) يديره الأدمن من لوحة التحكم ← الإعدادات.
     - مفتاح الـ API لا يُقرأ إلا من الأدمن أو من service_role (Edge Function).
*/

-- ─────────────────────────────────────────────────────────────
-- 1) إصلاح علاقات PostgREST
-- ─────────────────────────────────────────────────────────────
DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns
             WHERE table_schema = 'public' AND table_name = 'products' AND column_name = 'merchant_id')
     AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'products_merchant_id_profiles_fkey')
  THEN
    -- تنظيف أي قيم يتيمة قبل إضافة القيد
    UPDATE public.products p
       SET merchant_id = NULL
     WHERE p.merchant_id IS NOT NULL
       AND NOT EXISTS (SELECT 1 FROM public.profiles pr WHERE pr.id = p.merchant_id);

    ALTER TABLE public.products
      ADD CONSTRAINT products_merchant_id_profiles_fkey
      FOREIGN KEY (merchant_id) REFERENCES public.profiles(id) ON DELETE SET NULL;
  END IF;
END $$;

DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'orders_user_id_profiles_fkey')
     AND NOT EXISTS (
       SELECT 1 FROM public.orders o
        WHERE o.user_id IS NOT NULL
          AND NOT EXISTS (SELECT 1 FROM public.profiles pr WHERE pr.id = o.user_id)
     )
  THEN
    ALTER TABLE public.orders
      ADD CONSTRAINT orders_user_id_profiles_fkey
      FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;
  END IF;
END $$;

DO $$
BEGIN
  IF EXISTS (SELECT 1 FROM information_schema.columns
             WHERE table_schema = 'public' AND table_name = 'reels' AND column_name = 'merchant_id')
     AND NOT EXISTS (SELECT 1 FROM pg_constraint WHERE conname = 'reels_merchant_id_profiles_fkey')
  THEN
    UPDATE public.reels r
       SET merchant_id = NULL
     WHERE r.merchant_id IS NOT NULL
       AND NOT EXISTS (SELECT 1 FROM public.profiles pr WHERE pr.id = r.merchant_id);

    ALTER TABLE public.reels
      ADD CONSTRAINT reels_merchant_id_profiles_fkey
      FOREIGN KEY (merchant_id) REFERENCES public.profiles(id) ON DELETE SET NULL;
  END IF;
END $$;

NOTIFY pgrst, 'reload schema';

-- ─────────────────────────────────────────────────────────────
-- 2) جداول المحادثات
-- ─────────────────────────────────────────────────────────────
CREATE TABLE IF NOT EXISTS public.chats (
  id                uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  code              text UNIQUE NOT NULL,
  product_id        uuid NOT NULL REFERENCES public.products(id) ON DELETE CASCADE,
  customer_id       uuid NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  merchant_id       uuid NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,
  last_message      text,
  last_message_at   timestamptz NOT NULL DEFAULT now(),
  customer_unread   integer NOT NULL DEFAULT 0,
  merchant_unread   integer NOT NULL DEFAULT 0,
  is_archived       boolean NOT NULL DEFAULT false,
  created_at        timestamptz NOT NULL DEFAULT now()
);

CREATE UNIQUE INDEX IF NOT EXISTS chats_product_customer_key
  ON public.chats (product_id, customer_id);
CREATE INDEX IF NOT EXISTS chats_merchant_idx ON public.chats (merchant_id, last_message_at DESC);
CREATE INDEX IF NOT EXISTS chats_customer_idx ON public.chats (customer_id, last_message_at DESC);

CREATE TABLE IF NOT EXISTS public.chat_messages (
  id          uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  chat_id     uuid NOT NULL REFERENCES public.chats(id) ON DELETE CASCADE,
  sender_id   uuid REFERENCES public.profiles(id) ON DELETE SET NULL,
  sender_role text NOT NULL CHECK (sender_role IN ('customer', 'merchant', 'system')),
  body        text NOT NULL CHECK (length(btrim(body)) > 0),
  created_at  timestamptz NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS chat_messages_chat_idx ON public.chat_messages (chat_id, created_at ASC);

ALTER TABLE public.chats ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.chat_messages ENABLE ROW LEVEL SECURITY;

GRANT SELECT, INSERT, UPDATE ON public.chats TO authenticated;
GRANT SELECT, INSERT ON public.chat_messages TO authenticated;
GRANT ALL ON public.chats TO service_role;
GRANT ALL ON public.chat_messages TO service_role;

-- المحادثات: الأطراف + الأدمن
DROP POLICY IF EXISTS "chats_select_participants" ON public.chats;
CREATE POLICY "chats_select_participants" ON public.chats
  FOR SELECT TO authenticated
  USING (auth.uid() = customer_id OR auth.uid() = merchant_id OR public.is_admin());

DROP POLICY IF EXISTS "chats_update_participants" ON public.chats;
CREATE POLICY "chats_update_participants" ON public.chats
  FOR UPDATE TO authenticated
  USING (auth.uid() = customer_id OR auth.uid() = merchant_id OR public.is_admin())
  WITH CHECK (auth.uid() = customer_id OR auth.uid() = merchant_id OR public.is_admin());

-- الحذف للأدمن فقط (لا يستطيع الزبون ولا التاجر حذف أي محادثة)
DROP POLICY IF EXISTS "chats_delete_admin_only" ON public.chats;
CREATE POLICY "chats_delete_admin_only" ON public.chats
  FOR DELETE TO authenticated
  USING (public.is_admin());

-- الرسائل: قراءة لأطراف المحادثة + الأدمن
DROP POLICY IF EXISTS "chat_messages_select_participants" ON public.chat_messages;
CREATE POLICY "chat_messages_select_participants" ON public.chat_messages
  FOR SELECT TO authenticated
  USING (
    public.is_admin() OR EXISTS (
      SELECT 1 FROM public.chats c
       WHERE c.id = chat_messages.chat_id
         AND (c.customer_id = auth.uid() OR c.merchant_id = auth.uid())
    )
  );

DROP POLICY IF EXISTS "chat_messages_insert_participants" ON public.chat_messages;
CREATE POLICY "chat_messages_insert_participants" ON public.chat_messages
  FOR INSERT TO authenticated
  WITH CHECK (
    sender_id = auth.uid() AND EXISTS (
      SELECT 1 FROM public.chats c
       WHERE c.id = chat_messages.chat_id
         AND (
           (c.customer_id = auth.uid() AND chat_messages.sender_role = 'customer') OR
           (c.merchant_id = auth.uid() AND chat_messages.sender_role = 'merchant')
         )
    )
  );

-- لا سياسة UPDATE ولا DELETE للرسائل: محفوظة للأبد لكلا الطرفين.
DROP POLICY IF EXISTS "chat_messages_delete_admin_only" ON public.chat_messages;
CREATE POLICY "chat_messages_delete_admin_only" ON public.chat_messages
  FOR DELETE TO authenticated
  USING (public.is_admin());

-- ─────────────────────────────────────────────────────────────
-- 3) إنشاء/جلب محادثة لمنتج (الزبون هو من يفتحها)
-- ─────────────────────────────────────────────────────────────
CREATE OR REPLACE FUNCTION public.get_or_create_product_chat(p_product_id uuid)
RETURNS public.chats
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_uid        uuid := auth.uid();
  v_merchant   uuid;
  v_name       text;
  v_slug       text;
  v_chat       public.chats;
  v_code       text;
BEGIN
  IF v_uid IS NULL THEN
    RAISE EXCEPTION 'يجب تسجيل الدخول لبدء محادثة';
  END IF;

  SELECT merchant_id, name, slug INTO v_merchant, v_name, v_slug
    FROM public.products WHERE id = p_product_id;

  IF v_merchant IS NULL THEN
    RAISE EXCEPTION 'هذا المنتج غير مرتبط بتاجر';
  END IF;

  IF v_merchant = v_uid THEN
    RAISE EXCEPTION 'لا يمكنك بدء محادثة مع نفسك';
  END IF;

  SELECT * INTO v_chat FROM public.chats
   WHERE product_id = p_product_id AND customer_id = v_uid;

  IF FOUND THEN
    RETURN v_chat;
  END IF;

  v_code := 'Chat-' ||
            substr(md5(gen_random_uuid()::text), 1, 4) || '-' ||
            substr(md5(gen_random_uuid()::text), 1, 5) || '-' ||
            substr(md5(gen_random_uuid()::text), 1, 2);

  INSERT INTO public.chats (code, product_id, customer_id, merchant_id, last_message, last_message_at)
  VALUES (v_code, p_product_id, v_uid, v_merchant, v_name, now())
  RETURNING * INTO v_chat;

  -- أول رسالة دائماً: المنتج الذي فُتحت منه المحادثة
  INSERT INTO public.chat_messages (chat_id, sender_id, sender_role, body)
  VALUES (
    v_chat.id, NULL, 'system',
    'المنتج: ' || v_name || E'\n' || 'product://' || COALESCE(v_slug, p_product_id::text)
  );

  RETURN v_chat;
END $$;

REVOKE ALL ON FUNCTION public.get_or_create_product_chat(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.get_or_create_product_chat(uuid) TO authenticated;

-- ─────────────────────────────────────────────────────────────
-- 4) trigger: تحديث المحادثة + إشعار الطرف الآخر
-- ─────────────────────────────────────────────────────────────
CREATE OR REPLACE FUNCTION public.handle_new_chat_message()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_chat      public.chats;
  v_target    uuid;
  v_title     text;
BEGIN
  SELECT * INTO v_chat FROM public.chats WHERE id = NEW.chat_id;
  IF NOT FOUND THEN RETURN NEW; END IF;

  IF NEW.sender_role = 'customer' THEN
    UPDATE public.chats
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at,
           merchant_unread = merchant_unread + 1
     WHERE id = NEW.chat_id;
    v_target := v_chat.merchant_id;
    v_title  := 'رسالة جديدة — ' || v_chat.code;
  ELSIF NEW.sender_role = 'merchant' THEN
    UPDATE public.chats
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at,
           customer_unread = customer_unread + 1
     WHERE id = NEW.chat_id;
    v_target := v_chat.customer_id;
    v_title  := 'رد من التاجر';
  ELSE
    UPDATE public.chats
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at
     WHERE id = NEW.chat_id;
    RETURN NEW;
  END IF;

  IF v_target IS NOT NULL THEN
    INSERT INTO public.notifications (user_id, type, title, body, data)
    VALUES (
      v_target, 'chat', v_title, left(NEW.body, 160),
      jsonb_build_object('chat_id', v_chat.id, 'code', v_chat.code, 'product_id', v_chat.product_id)
    );
  END IF;

  RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_new_chat_message ON public.chat_messages;
CREATE TRIGGER trg_new_chat_message
  AFTER INSERT ON public.chat_messages
  FOR EACH ROW EXECUTE FUNCTION public.handle_new_chat_message();

-- تصفير عدّاد غير المقروء عند فتح المحادثة
CREATE OR REPLACE FUNCTION public.mark_chat_read(p_chat_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE v_uid uuid := auth.uid();
BEGIN
  UPDATE public.chats
     SET customer_unread = CASE WHEN customer_id = v_uid THEN 0 ELSE customer_unread END,
         merchant_unread = CASE WHEN merchant_id = v_uid THEN 0 ELSE merchant_unread END
   WHERE id = p_chat_id AND (customer_id = v_uid OR merchant_id = v_uid);
END $$;

REVOKE ALL ON FUNCTION public.mark_chat_read(uuid) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION public.mark_chat_read(uuid) TO authenticated;

