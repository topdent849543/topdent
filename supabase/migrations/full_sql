-- ════════════════════════════════════════════════════════════
-- 10. ضمان ربط الطلب بكود الأفلييت بعد إنشائه
--     (يُستدعى من التطبيق بعد نجاح الطلب، في حال لم تُخزّن دالة
--      إنشاء الطلب الكود بنفسها)
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.attach_order_affiliate(
  p_order_id uuid,
  p_code     text
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_order record;
  v_link  record;
BEGIN
  IF p_order_id IS NULL OR p_code IS NULL OR btrim(p_code) = '' THEN
    RETURN jsonb_build_object('linked', false, 'reason', 'missing_input');
  END IF;

  SELECT * INTO v_order FROM public.orders WHERE id = p_order_id;
  IF v_order.id IS NULL THEN
    RETURN jsonb_build_object('linked', false, 'reason', 'order_not_found');
  END IF;

  -- المشتري نفسه أو الأدمن فقط
  IF v_order.user_id <> auth.uid() AND NOT public.is_admin() THEN
    RAISE EXCEPTION 'Not allowed';
  END IF;

  IF v_order.affiliate_user_id IS NOT NULL THEN
    RETURN jsonb_build_object('linked', true, 'reason', 'already_linked');
  END IF;

  SELECT id, user_id INTO v_link
    FROM public.affiliate_links
   WHERE affiliate_code = p_code
   LIMIT 1;

  IF v_link.user_id IS NULL OR v_link.user_id = v_order.user_id THEN
    RETURN jsonb_build_object('linked', false, 'reason', 'invalid_code');
  END IF;

  UPDATE public.orders
     SET affiliate_code    = p_code,
         affiliate_user_id = v_link.user_id
   WHERE id = p_order_id;

  -- احتساب العمولة فوراً (idempotent)
  PERFORM public.process_order_merchant_earnings(p_order_id);

  RETURN jsonb_build_object('linked', true, 'publisher_id', v_link.user_id);
END;
$$;

GRANT EXECUTE ON FUNCTION public.attach_order_affiliate(uuid, text) TO authenticated, service_role;

-- ════════════════════════════════════════════════════════════════════════
--  11) مبيعات الأفلييت الفورية، البانرات، وحذف الحساب
--  (20260812150000_instant_affiliate_sales_banners_account_deletion.sql)
-- ════════════════════════════════════════════════════════════════════════

/*
  ════════════════════════════════════════════════════════════════════════
  تحديث شامل (بدون إزالة أي شيء قائم):

  1) الأفلييت: عمولة الناشر تُضاف فوراً إلى الرصيد المتاح (available_balance)
     بمجرد إنشاء الطلب ودفع الدفعة المقدمة (25% حالياً) — بدون "قيد الانتظار".
     + ترحيل رجعي لكل العمولات المعلّقة الحالية إلى الرصيد المتاح.

  2) التاجر: تبقى المبيعات "معلّقة" (pending) لكن بمسمّى «مبيعات معلقة»،
     وتتحوّل إلى «مبيعات مؤكدة» (رصيد متاح) لحظة تأكيد الطلب
     (status = 'confirmed' أو أي حالة لاحقة).

  3) البنرات: صلاحيات كاملة للأدمن + أعمدة إضافية + توسيع أماكن الظهور.

  4) حذف الحساب: دالة delete_my_account() يحذف بها المستخدم حسابه نهائياً.

  كل شيء idempotent ويمكن تنفيذه أكثر من مرة بأمان.
*/

-- ════════════════════════════════════════════════════════════
-- 0. وصف الحركات (مسميّات موحّدة)
-- ════════════════════════════════════════════════════════════
-- مبيعات معلقة   → التاجر قبل تأكيد الطلب
-- مبيعات مؤكدة   → التاجر بعد تأكيد الطلب
-- عمولة تسويق    → الناشر (فوري)

-- ════════════════════════════════════════════════════════════
-- 1. احتساب الأرباح لكل بند طلب (نسخة محدّثة)
--    - الناشر: available_balance فوراً + حركة 'credit' مكتملة
--    - التاجر: pending_balance + حركة 'pending_credit' معلّقة
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.credit_order_item_earnings(p_order_item_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  item            record;
  v_merchant_earn numeric(12,2);
  v_aff_earn      numeric(12,2);
  v_hold          timestamptz;
  w_id            uuid;
  v_link_id       uuid;
  v_merchant_pct  numeric := 75;
  v_aff_pct       numeric := 10;
  v_settings      jsonb;
BEGIN
  SELECT oi.id, oi.order_id, oi.product_id, oi.subtotal, oi.hold_until,
         COALESCE(oi.merchant_id, p.merchant_id) AS merchant_id,
         o.affiliate_user_id, o.affiliate_code, o.status AS order_status
    INTO item
    FROM public.order_items oi
    JOIN public.orders o ON o.id = oi.order_id
    LEFT JOIN public.products p ON p.id = oi.product_id
   WHERE oi.id = p_order_item_id;

  IF item.id IS NULL THEN
    RETURN;
  END IF;

  -- النسب من الإعدادات العامة إن كانت متاحة
  BEGIN
    SELECT public.get_app_settings() INTO v_settings;
    IF v_settings IS NOT NULL THEN
      v_merchant_pct := COALESCE((v_settings->>'merchant_percentage')::numeric, v_merchant_pct);
      v_aff_pct      := COALESCE((v_settings->>'affiliate_percentage')::numeric, v_aff_pct);
    END IF;
  EXCEPTION WHEN OTHERS THEN
    NULL;
  END;

  v_hold := COALESCE(item.hold_until, now() + interval '10 days');
  v_merchant_earn := ROUND(COALESCE(item.subtotal, 0) * (v_merchant_pct / 100.0), 2);
  v_aff_earn := CASE WHEN item.affiliate_user_id IS NOT NULL
                     THEN ROUND(COALESCE(item.subtotal, 0) * (v_aff_pct / 100.0), 2)
                     ELSE 0 END;

  UPDATE public.order_items
     SET merchant_id        = item.merchant_id,
         merchant_earnings  = v_merchant_earn,
         affiliate_earnings = v_aff_earn,
         hold_until         = v_hold
   WHERE id = item.id;

  -- ── مبيعات التاجر (معلّقة حتى تأكيد الطلب) ────────────────
  IF item.merchant_id IS NOT NULL AND v_merchant_earn > 0
     AND NOT EXISTS (
       SELECT 1 FROM public.wallet_transactions
        WHERE order_item_id = item.id
          AND user_id = item.merchant_id
          AND type IN ('pending_credit', 'credit')
     ) THEN
    INSERT INTO public.wallets (user_id) VALUES (item.merchant_id)
      ON CONFLICT (user_id) DO NOTHING;
    SELECT id INTO w_id FROM public.wallets WHERE user_id = item.merchant_id;

    UPDATE public.wallets
       SET pending_balance = pending_balance + v_merchant_earn,
           total_earned    = total_earned + v_merchant_earn,
           updated_at      = now()
     WHERE user_id = item.merchant_id;

    INSERT INTO public.wallet_transactions
      (wallet_id, user_id, type, amount, description, order_id, order_item_id, status)
    VALUES
      (w_id, item.merchant_id, 'pending_credit', v_merchant_earn,
       'مبيعات معلقة من طلب — تتحوّل إلى مبيعات مؤكدة عند تأكيد الطلب',
       item.order_id, item.id, 'pending');
  END IF;

  -- ── عمولة الناشر (الأفلييت) — فورية وبدون تجميد ────────────
  IF item.affiliate_user_id IS NOT NULL AND v_aff_earn > 0
     AND NOT EXISTS (
       SELECT 1 FROM public.wallet_transactions
        WHERE order_item_id = item.id
          AND user_id = item.affiliate_user_id
          AND type IN ('pending_credit', 'credit')
     ) THEN
    INSERT INTO public.wallets (user_id) VALUES (item.affiliate_user_id)
      ON CONFLICT (user_id) DO NOTHING;
    SELECT id INTO w_id FROM public.wallets WHERE user_id = item.affiliate_user_id;

    UPDATE public.wallets
       SET available_balance = available_balance + v_aff_earn,
           total_earned      = total_earned + v_aff_earn,
           updated_at        = now()
     WHERE user_id = item.affiliate_user_id;

    INSERT INTO public.wallet_transactions
      (wallet_id, user_id, type, amount, description, order_id, order_item_id, status)
    VALUES
      (w_id, item.affiliate_user_id, 'credit', v_aff_earn,
       'عمولة تسويق بالعمولة — متاحة فوراً', item.order_id, item.id, 'completed');

    -- إحصاءات رابط الأفلييت
    SELECT id INTO v_link_id
      FROM public.affiliate_links
     WHERE user_id = item.affiliate_user_id
       AND (affiliate_code = item.affiliate_code OR product_id = item.product_id)
     ORDER BY (affiliate_code = item.affiliate_code) DESC
     LIMIT 1;

    IF v_link_id IS NOT NULL THEN
      UPDATE public.affiliate_links
         SET purchases_count = purchases_count + 1,
             total_earnings  = total_earnings + v_aff_earn
       WHERE id = v_link_id;
    END IF;

    -- إشعار الناشر (إن كان جدول الإشعارات موجوداً)
    BEGIN
      INSERT INTO public.notifications (user_id, type, title, body, data)
      VALUES (item.affiliate_user_id, 'affiliate',
              'عمولة جديدة في محفظتك',
              'تمت إضافة ' || v_aff_earn::text || '$ إلى رصيدك المتاح من عملية شراء عبر رابطك.',
              jsonb_build_object('order_id', item.order_id, 'amount', v_aff_earn));
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;
  END IF;
END;
$$;

GRANT EXECUTE ON FUNCTION public.credit_order_item_earnings(uuid) TO authenticated, service_role;

-- ════════════════════════════════════════════════════════════
-- 2. تحرير مبيعات التاجر عند تأكيد الطلب («مبيعات مؤكدة»)
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.confirm_order_merchant_sales(p_order_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  tx    record;
  w_id  uuid;
BEGIN
  FOR tx IN
    SELECT wt.id, wt.user_id, wt.amount, wt.order_item_id
      FROM public.wallet_transactions wt
     WHERE wt.order_id = p_order_id
       AND wt.type = 'pending_credit'
       AND wt.status = 'pending'
  LOOP
    SELECT id INTO w_id FROM public.wallets WHERE user_id = tx.user_id;
    IF w_id IS NULL THEN
      CONTINUE;
    END IF;

    UPDATE public.wallets
       SET pending_balance   = GREATEST(pending_balance - tx.amount, 0),
           available_balance = available_balance + tx.amount,
           updated_at        = now()
     WHERE user_id = tx.user_id;

    UPDATE public.wallet_transactions
       SET status      = 'completed',
           description = 'مبيعات مؤكدة من طلب'
     WHERE id = tx.id;

    INSERT INTO public.wallet_transactions
      (wallet_id, user_id, type, amount, description, order_id, order_item_id, status)
    VALUES
      (w_id, tx.user_id, 'pending_release', tx.amount,
       'مبيعات مؤكدة — أصبحت متاحة في رصيدك', p_order_id, tx.order_item_id, 'completed');

    UPDATE public.order_items SET hold_until = NULL WHERE id = tx.order_item_id;
  END LOOP;
END;
$$;

