/* إشعار الطرف الآخر عند كل رسالة داخل التذكرة */
CREATE OR REPLACE FUNCTION public.handle_support_ticket_message()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_ticket public.support_tickets;
BEGIN
  SELECT * INTO v_ticket FROM public.support_tickets WHERE id = NEW.ticket_id;
  IF NOT FOUND THEN RETURN NEW; END IF;

  IF NEW.sender_role = 'admin' THEN
    UPDATE public.support_tickets
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at,
           user_unread = user_unread + 1,
           status = CASE WHEN status = 'open' THEN 'pending' ELSE status END
     WHERE id = NEW.ticket_id;

    INSERT INTO public.notifications (user_id, type, title, body, data)
    VALUES (
      v_ticket.user_id, 'support',
      'رد من الدعم — ' || COALESCE(v_ticket.ticket_number, ''),
      left(NEW.body, 160),
      jsonb_build_object('ticket_id', v_ticket.id, 'ticket_number', v_ticket.ticket_number)
    );
  ELSIF NEW.sender_role = 'customer' THEN
    UPDATE public.support_tickets
       SET last_message = left(NEW.body, 160),
           last_message_at = NEW.created_at,
           admin_unread = admin_unread + 1
     WHERE id = NEW.ticket_id;

    INSERT INTO public.notifications (user_id, type, title, body, data)
    SELECT p.id, 'support',
           'رسالة جديدة في تذكرة ' || COALESCE(v_ticket.ticket_number, ''),
           left(NEW.body, 160),
           jsonb_build_object('ticket_id', v_ticket.id, 'ticket_number', v_ticket.ticket_number)
      FROM public.profiles p WHERE p.role = 'admin';
  END IF;

  RETURN NEW;
END $$;

DROP TRIGGER IF EXISTS trg_support_ticket_message ON public.support_ticket_messages;
CREATE TRIGGER trg_support_ticket_message
  AFTER INSERT ON public.support_ticket_messages
  FOR EACH ROW EXECUTE FUNCTION public.handle_support_ticket_message();

