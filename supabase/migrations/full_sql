RETURNS TABLE (
  id uuid, ticket_number text, subject text, message text, category text,
  status text, priority text, created_at timestamptz, last_message text,
  last_message_at timestamptz, admin_unread integer,
  user_id uuid, customer_name text, customer_email text
)
LANGUAGE sql
