{
  "expo": {
    "name": "TopDent",
    "slug": "topdent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "topdent",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#e8f4f8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.topdent.app",
      "config": {
        "google": {
          "reservedClientId": "YOUR_GOOGLE_CLIENT_ID_HERE"
        }
      }
    },
    "android": {
      "package": "com.topdent.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#e8f4f8"
      },
      "permissions": ["INTERNET"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
