  FOR UPDATE TO authenticated
  USING (auth.uid() = customer_id OR auth.uid() = merchant_id OR public.is_admin())
  WITH CHECK (auth.uid() = customer_id OR auth.uid() = merchant_id OR public.is_admin());

-- الحذف للأدمن فقط (لا يستطيع الزبون ولا التاجر حذف أي محادثة)
DROP POLICY IF EXISTS "chats_delete_admin_only" ON public.chats;
CREATE POLICY "chats_delete_admin_only" ON public.chats
  FOR DELETE TO authenticated
