-- 3. ربط الطلب بالناشر انطلاقاً من كود الأفلييت
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.resolve_order_affiliate()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE v_link record;
BEGIN
  IF NEW.affiliate_code IS NOT NULL AND NEW.affiliate_user_id IS NULL THEN
    SELECT id, user_id INTO v_link
      FROM public.affiliate_links
      WHERE affiliate_code = NEW.affiliate_code
      LIMIT 1;

    -- لا يُحتسب الأفلييت إذا كان المشتري هو الناشر نفسه
    IF v_link.user_id IS NOT NULL AND v_link.user_id <> NEW.user_id THEN
      NEW.affiliate_user_id := v_link.user_id;
    END IF;
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_orders_resolve_affiliate ON public.orders;
CREATE TRIGGER trg_orders_resolve_affiliate
  BEFORE INSERT OR UPDATE OF affiliate_code ON public.orders
  FOR EACH ROW EXECUTE FUNCTION public.resolve_order_affiliate();

-- ════════════════════════════════════════════════════════════
-- 4. احتساب الأرباح لكل بند طلب (idempotent)
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.credit_order_item_earnings(p_order_item_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  item            record;
  v_merchant_earn numeric(12,2);
  v_aff_earn      numeric(12,2);
  v_hold          timestamptz;
  w_id            uuid;
  v_link_id       uuid;
BEGIN
  SELECT oi.id, oi.order_id, oi.product_id, oi.subtotal, oi.hold_until,
         COALESCE(oi.merchant_id, p.merchant_id) AS merchant_id,
         o.affiliate_user_id, o.affiliate_code
    INTO item
    FROM public.order_items oi
    JOIN public.orders o ON o.id = oi.order_id
    LEFT JOIN public.products p ON p.id = oi.product_id
   WHERE oi.id = p_order_item_id;

  IF item.id IS NULL THEN
    RETURN;
  END IF;

  v_hold := COALESCE(item.hold_until, now() + interval '10 days');
  v_merchant_earn := ROUND(COALESCE(item.subtotal, 0) * 0.75, 2);
  v_aff_earn := CASE WHEN item.affiliate_user_id IS NOT NULL
                     THEN ROUND(COALESCE(item.subtotal, 0) * 0.10, 2)
                     ELSE 0 END;

  UPDATE public.order_items
     SET merchant_id        = item.merchant_id,
         merchant_earnings  = v_merchant_earn,
         affiliate_earnings = v_aff_earn,
         hold_until         = v_hold
   WHERE id = item.id;

  -- ── أرباح التاجر ─────────────────────────────────────────
  IF item.merchant_id IS NOT NULL AND v_merchant_earn > 0
     AND NOT EXISTS (
       SELECT 1 FROM public.wallet_transactions
        WHERE order_item_id = item.id
          AND user_id = item.merchant_id
          AND type = 'pending_credit'
     ) THEN
    INSERT INTO public.wallets (user_id) VALUES (item.merchant_id)
      ON CONFLICT (user_id) DO NOTHING;
    SELECT id INTO w_id FROM public.wallets WHERE user_id = item.merchant_id;

    UPDATE public.wallets
       SET pending_balance = pending_balance + v_merchant_earn,
           total_earned    = total_earned + v_merchant_earn,
           updated_at      = now()
     WHERE user_id = item.merchant_id;

    INSERT INTO public.wallet_transactions
      (wallet_id, user_id, type, amount, description, order_id, order_item_id, status)
    VALUES
      (w_id, item.merchant_id, 'pending_credit', v_merchant_earn,
       'أرباح بيع من طلب (تجميد 10 أيام)', item.order_id, item.id, 'pending');
  END IF;

  -- ── عمولة الناشر (الأفلييت) ──────────────────────────────
  IF item.affiliate_user_id IS NOT NULL AND v_aff_earn > 0
     AND NOT EXISTS (
       SELECT 1 FROM public.wallet_transactions
        WHERE order_item_id = item.id
          AND user_id = item.affiliate_user_id
          AND type = 'pending_credit'
     ) THEN
    INSERT INTO public.wallets (user_id) VALUES (item.affiliate_user_id)
      ON CONFLICT (user_id) DO NOTHING;
    SELECT id INTO w_id FROM public.wallets WHERE user_id = item.affiliate_user_id;

    UPDATE public.wallets
       SET pending_balance = pending_balance + v_aff_earn,
           total_earned    = total_earned + v_aff_earn,
           updated_at      = now()
     WHERE user_id = item.affiliate_user_id;

    INSERT INTO public.wallet_transactions
      (wallet_id, user_id, type, amount, description, order_id, order_item_id, status)
    VALUES
      (w_id, item.affiliate_user_id, 'pending_credit', v_aff_earn,
       'عمولة تسويق بالعمولة (تجميد 10 أيام)', item.order_id, item.id, 'pending');

    -- إحصاءات رابط الأفلييت
    SELECT id INTO v_link_id
      FROM public.affiliate_links
     WHERE user_id = item.affiliate_user_id
       AND (affiliate_code = item.affiliate_code OR product_id = item.product_id)
     ORDER BY (affiliate_code = item.affiliate_code) DESC
     LIMIT 1;

    IF v_link_id IS NOT NULL THEN
      UPDATE public.affiliate_links
         SET purchases_count = purchases_count + 1,
             total_earnings  = total_earnings + v_aff_earn
       WHERE id = v_link_id;
    END IF;
  END IF;
END;
$$;

GRANT EXECUTE ON FUNCTION public.credit_order_item_earnings(uuid) TO authenticated, service_role;

-- الدالة القديمة تبقى موجودة لكن صارت تعتمد على الدالة الذرّية أعلاه
CREATE OR REPLACE FUNCTION public.process_order_merchant_earnings(p_order_id uuid)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE r record;
BEGIN
  FOR r IN SELECT id FROM public.order_items WHERE order_id = p_order_id LOOP
    PERFORM public.credit_order_item_earnings(r.id);
  END LOOP;
END;
$$;

GRANT EXECUTE ON FUNCTION public.process_order_merchant_earnings(uuid) TO authenticated, service_role;

-- ⚠️ كانت هذه الدالة لا تُستدعى من أي مكان: هنا يتم ربطها بـ trigger
CREATE OR REPLACE FUNCTION public.trg_order_item_earnings()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  PERFORM public.credit_order_item_earnings(NEW.id);
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_order_items_earnings ON public.order_items;
CREATE TRIGGER trg_order_items_earnings
  AFTER INSERT ON public.order_items
  FOR EACH ROW EXECUTE FUNCTION public.trg_order_item_earnings();

-- في حال تم ربط الطلب بالأفلييت بعد إنشاء البنود
CREATE OR REPLACE FUNCTION public.trg_order_affiliate_backfill()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
BEGIN
  IF NEW.affiliate_user_id IS NOT NULL
     AND COALESCE(OLD.affiliate_user_id::text, '') <> COALESCE(NEW.affiliate_user_id::text, '') THEN
    PERFORM public.process_order_merchant_earnings(NEW.id);
  END IF;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS trg_orders_affiliate_backfill ON public.orders;
CREATE TRIGGER trg_orders_affiliate_backfill
  AFTER UPDATE OF affiliate_user_id ON public.orders
  FOR EACH ROW EXECUTE FUNCTION public.trg_order_affiliate_backfill();

-- ════════════════════════════════════════════════════════════
-- 5. تعبئة رجعية للطلبات السابقة
-- ════════════════════════════════════════════════════════════
DO $$
DECLARE r record;
BEGIN
  -- ربط الطلبات القديمة التي تحمل كود أفلييت بدون ناشر
  UPDATE public.orders o
     SET affiliate_user_id = al.user_id
    FROM public.affiliate_links al
   WHERE o.affiliate_code = al.affiliate_code
     AND o.affiliate_user_id IS NULL
     AND al.user_id <> o.user_id;

  -- احتساب الأرباح غير المحتسبة
  FOR r IN
    SELECT oi.id
      FROM public.order_items oi
      JOIN public.orders o ON o.id = oi.order_id
     WHERE NOT EXISTS (
       SELECT 1 FROM public.wallet_transactions wt
        WHERE wt.order_item_id = oi.id AND wt.type = 'pending_credit'
     )
  LOOP
    PERFORM public.credit_order_item_earnings(r.id);
  END LOOP;
END $$;

-- إعادة ضبط إحصاءات روابط الأفلييت من الواقع الفعلي
UPDATE public.affiliate_links al
   SET purchases_count = COALESCE(stats.cnt, 0),
       total_earnings  = COALESCE(stats.earn, 0)
  FROM (
    SELECT o.affiliate_user_id AS user_id,
           oi.product_id,
           COUNT(*) AS cnt,
           SUM(oi.affiliate_earnings) AS earn
      FROM public.order_items oi
      JOIN public.orders o ON o.id = oi.order_id
     WHERE o.affiliate_user_id IS NOT NULL
       AND oi.affiliate_earnings > 0
     GROUP BY o.affiliate_user_id, oi.product_id
  ) stats
 WHERE al.user_id = stats.user_id
   AND al.product_id = stats.product_id;

-- ════════════════════════════════════════════════════════════
-- 6. قائمة الناشرين المستحقين للسحب (للأدمن)
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.admin_list_payout_candidates()
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE v_rows jsonb;
BEGIN
  IF NOT public.is_admin() THEN
    RAISE EXCEPTION 'Admin access required';
  END IF;

  -- تحرير الأرباح التي انتهت مدة تجميدها قبل حساب من يستحق السحب
  BEGIN
    PERFORM public.release_pending_earnings();
  EXCEPTION WHEN undefined_function THEN
    NULL;
  END;

  SELECT COALESCE(jsonb_agg(x ORDER BY (x->>'available_balance')::numeric DESC), '[]'::jsonb)
    INTO v_rows
    FROM (
      SELECT jsonb_build_object(
               'user_id',           w.user_id,
               'full_name',         pf.full_name,
               'phone',             pf.phone,
               'role',              pf.role,
               'ref_code',          pf.ref_code,
               'available_balance', COALESCE(w.available_balance, 0),
               'pending_balance',   COALESCE(w.pending_balance, 0),
               'total_earned',      COALESCE(w.total_earned, 0),
               'total_withdrawn',   COALESCE(w.total_withdrawn, 0),
               'min_threshold',     ws.min_threshold,
               'payment_method',    ws.payment_method,
               'account_details',   ws.account_details,
               'is_eligible',       COALESCE(w.available_balance, 0) >= ws.min_threshold
             ) AS x
        FROM public.withdrawal_settings ws
        JOIN public.wallets w  ON w.user_id = ws.user_id
        LEFT JOIN public.profiles pf ON pf.id = ws.user_id
       WHERE COALESCE(w.available_balance, 0) >= ws.min_threshold
    ) s;

  RETURN v_rows;
END;
$$;

GRANT EXECUTE ON FUNCTION public.admin_list_payout_candidates() TO authenticated, service_role;

-- ════════════════════════════════════════════════════════════
-- 7. تفاصيل حساب الناشر: الرصيد + السحوبات + الأرباح
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.admin_publisher_payout_overview(p_user_id uuid)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_wallet      record;
  v_settings    record;
  v_profile     record;
  v_withdrawals jsonb;
  v_earnings    jsonb;
  v_links       jsonb;
BEGIN
  IF NOT public.is_admin() THEN
    RAISE EXCEPTION 'Admin access required';
  END IF;

  SELECT * INTO v_wallet   FROM public.wallets             WHERE user_id = p_user_id;
  SELECT * INTO v_settings FROM public.withdrawal_settings WHERE user_id = p_user_id;
  SELECT * INTO v_profile  FROM public.profiles            WHERE id = p_user_id;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
           'id',             wr.id,
           'amount',         wr.amount,
           'status',         wr.status,
           'payment_info',   wr.payment_info,
           'admin_notes',    wr.admin_notes,
           'invoice_number', wr.invoice_number,
           'invoice_token',  wr.invoice_token,
           'created_at',     wr.created_at,
           'processed_at',   wr.processed_at
         ) ORDER BY wr.created_at DESC), '[]'::jsonb)
    INTO v_withdrawals
    FROM public.withdrawal_requests wr
   WHERE wr.user_id = p_user_id;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
           'id',          wt.id,
           'type',        wt.type,
           'amount',      wt.amount,
           'status',      wt.status,
           'description', wt.description,
           'order_id',    wt.order_id,
           'created_at',  wt.created_at
         ) ORDER BY wt.created_at DESC), '[]'::jsonb)
    INTO v_earnings
    FROM (
      SELECT * FROM public.wallet_transactions
       WHERE user_id = p_user_id
       ORDER BY created_at DESC
       LIMIT 100
    ) wt;

  SELECT COALESCE(jsonb_agg(jsonb_build_object(
           'id',              al.id,
           'affiliate_code',  al.affiliate_code,
           'product_name',    p.name,
           'clicks_count',    al.clicks_count,
           'purchases_count', al.purchases_count,
           'total_earnings',  al.total_earnings
         ) ORDER BY al.total_earnings DESC), '[]'::jsonb)
    INTO v_links
    FROM public.affiliate_links al
    LEFT JOIN public.products p ON p.id = al.product_id
   WHERE al.user_id = p_user_id;

  RETURN jsonb_build_object(
    'user_id',   p_user_id,
    'profile',   jsonb_build_object(
                   'full_name', v_profile.full_name,
                   'phone',     v_profile.phone,
                   'role',      v_profile.role,
                   'ref_code',  v_profile.ref_code
                 ),
    'wallet',    jsonb_build_object(
                   'available_balance', COALESCE(v_wallet.available_balance, 0),
                   'pending_balance',   COALESCE(v_wallet.pending_balance, 0),
                   'total_earned',      COALESCE(v_wallet.total_earned, 0),
                   'total_withdrawn',   COALESCE(v_wallet.total_withdrawn, 0)
                 ),
    'settings',  CASE WHEN v_settings.user_id IS NULL THEN NULL ELSE jsonb_build_object(
                   'min_threshold',   v_settings.min_threshold,
                   'payment_method',  v_settings.payment_method,
                   'account_details', v_settings.account_details
                 ) END,
    'withdrawals', v_withdrawals,
    'transactions', v_earnings,
    'affiliate_links', v_links
  );
END;
$$;

GRANT EXECUTE ON FUNCTION public.admin_publisher_payout_overview(uuid) TO authenticated, service_role;

-- ════════════════════════════════════════════════════════════
-- 8. تنفيذ السحب من قبل الأدمن بمبلغ محدد
-- ════════════════════════════════════════════════════════════
CREATE OR REPLACE FUNCTION public.admin_pay_withdrawal(
  p_user_id uuid,
  p_amount  numeric,
  p_notes   text DEFAULT NULL
)
RETURNS jsonb
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_admin     uuid := auth.uid();
  v_settings  record;
  v_wallet    record;
  v_amount    numeric(12,2);
  v_pay_info  text;
  v_wr        record;
  w_id        uuid;
BEGIN
  IF NOT public.is_admin(v_admin) THEN
    RAISE EXCEPTION 'Admin access required';
  END IF;

  v_amount := ROUND(COALESCE(p_amount, 0)::numeric, 2);
  IF v_amount <= 0 THEN
    RAISE EXCEPTION 'المبلغ يجب أن يكون أكبر من صفر';
  END IF;

  SELECT * INTO v_wallet FROM public.wallets WHERE user_id = p_user_id FOR UPDATE;
  IF v_wallet.user_id IS NULL THEN
    RAISE EXCEPTION 'لا توجد محفظة لهذا المستخدم';
  END IF;

  IF v_amount > COALESCE(v_wallet.available_balance, 0) THEN
    RAISE EXCEPTION 'المبلغ المطلوب (%) أكبر من الرصيد المتاح (%)',
      v_amount, COALESCE(v_wallet.available_balance, 0);
  END IF;

  SELECT * INTO v_settings FROM public.withdrawal_settings WHERE user_id = p_user_id;

  v_pay_info := COALESCE(
    (SELECT jsonb_build_object('method', v_settings.payment_method)
            || COALESCE(v_settings.account_details, '{}'::jsonb))::text,
    '{}'
  );

  INSERT INTO public.withdrawal_requests
    (user_id, amount, payment_info, status, admin_notes, processed_at)
  VALUES
    (p_user_id, v_amount, v_pay_info, 'paid', p_notes, now())
  RETURNING * INTO v_wr;

  -- خصم المبلغ من الرصيد المتاح + تسجيل الحركة
  UPDATE public.wallets
     SET available_balance = GREATEST(COALESCE(available_balance, 0) - v_amount, 0),
         total_withdrawn   = COALESCE(total_withdrawn, 0) + v_amount,
         updated_at        = now()
   WHERE user_id = p_user_id;

  SELECT id INTO w_id FROM public.wallets WHERE user_id = p_user_id;

  INSERT INTO public.wallet_transactions
    (wallet_id, user_id, type, amount, description, withdrawal_id, status)
  VALUES
    (w_id, p_user_id, 'withdrawal', v_amount,
     'سحب مبلغ - فاتورة ' || COALESCE(v_wr.invoice_number, '—'),
     v_wr.id, 'completed');

  -- إشعار الناشر مع رقم الفاتورة ورابط الفاتورة الموقّعة بـ QR
  BEGIN
    INSERT INTO public.notifications (user_id, type, title, body, data, is_read)
    VALUES (
      p_user_id,
      'payment_processed',
      'تم تنفيذ عملية سحب',
      'تم سحب مبلغ $' || to_char(v_amount, 'FM999999990.00') ||
        ' وإرساله إلى عنوان المحفظة المحدد. رقم الفاتورة: ' ||
        COALESCE(v_wr.invoice_number, '—'),
      jsonb_build_object(
        'withdrawal_id',  v_wr.id,
        'invoice_number', v_wr.invoice_number,
        'invoice_token',  v_wr.invoice_token,
        'invoice_url',    '/inv/' || v_wr.invoice_token,
        'amount',         v_amount,
        'payment_method', v_settings.payment_method
      ),
      false
    );
  EXCEPTION WHEN undefined_table OR undefined_column THEN
    NULL; -- الإشعارات اختيارية ولا يجب أن تُفشل عملية السحب
  END;

  SELECT * INTO v_wallet FROM public.wallets WHERE user_id = p_user_id;

  RETURN jsonb_build_object(
    'withdrawal_id',     v_wr.id,
    'amount',            v_amount,
    'invoice_number',    v_wr.invoice_number,
    'invoice_token',     v_wr.invoice_token,
    'payment_info',      v_pay_info,
    'available_balance', COALESCE(v_wallet.available_balance, 0)
  );
END;
$$;

GRANT EXECUTE ON FUNCTION public.admin_pay_withdrawal(uuid, numeric, text) TO authenticated, service_role;

