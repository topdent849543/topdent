/*
  حفظ كل صور المنتج دفعة واحدة.
  p_images = [{"url": "...", "is_primary": true}, ...] بالترتيب المطلوب.
*/
CREATE OR REPLACE FUNCTION public.sync_product_images(p_product_id uuid, p_images jsonb)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = public
AS $$
DECLARE
  v_item     jsonb;
  v_index    int := 0;
  v_urls     text[] := ARRAY[]::text[];
  v_primary  text;
BEGIN
  IF NOT public.can_manage_product(p_product_id) THEN
    RAISE EXCEPTION 'غير مصرّح لك بتعديل صور هذا المنتج';
  END IF;

  IF p_images IS NULL OR jsonb_typeof(p_images) <> 'array' THEN
    RETURN;
  END IF;

  FOR v_item IN SELECT * FROM jsonb_array_elements(p_images) LOOP
    IF COALESCE(btrim(v_item->>'url'), '') <> '' THEN
      v_urls := array_append(v_urls, btrim(v_item->>'url'));
      IF COALESCE((v_item->>'is_primary')::boolean, false) THEN
        v_primary := btrim(v_item->>'url');
      END IF;
    END IF;
  END LOOP;

  IF array_length(v_urls, 1) IS NULL THEN
    DELETE FROM public.product_images WHERE product_id = p_product_id;
    RETURN;
  END IF;

  IF v_primary IS NULL THEN
    v_primary := v_urls[1];
  END IF;

  -- الصورة الرئيسية دائماً أول الترتيب حتى تظهر في الصفحة الرئيسية والبطاقات
  SELECT array_agg(u ORDER BY (u = v_primary) DESC, ord)
    INTO v_urls
    FROM unnest(v_urls) WITH ORDINALITY AS t(u, ord);

  -- حذف الصور التي أزالها المستخدم
  DELETE FROM public.product_images
   WHERE product_id = p_product_id
     AND NOT (image_url = ANY (v_urls));

  -- إدراج/تحديث الترتيب والصورة الرئيسية
  FOR v_index IN 1 .. array_length(v_urls, 1) LOOP
    IF EXISTS (SELECT 1 FROM public.product_images
                WHERE product_id = p_product_id AND image_url = v_urls[v_index]) THEN
      UPDATE public.product_images
         SET sort_order = v_index - 1,
             is_primary = (v_urls[v_index] = v_primary)
       WHERE product_id = p_product_id AND image_url = v_urls[v_index];
    ELSE
      INSERT INTO public.product_images (product_id, image_url, sort_order, is_primary)
      VALUES (p_product_id, v_urls[v_index], v_index - 1, v_urls[v_index] = v_primary);
    END IF;
  END LOOP;
END $$;

GRANT EXECUTE ON FUNCTION public.sync_product_images(uuid, jsonb) TO authenticated, service_role;

